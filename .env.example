# DHABI BANK NOTIFICATIONS - ENVIRONMENT VARIABLES
# Copia este archivo como .env si deseas personalizar las variables locales.

# Secret estático de validación JWT
DHABI_JWT_SECRET=dhabi-secret-2024

# Configuración de PostgreSQL
POSTGRES_USER=dhabi_user
POSTGRES_PASSWORD=dhabi_pass
POSTGRES_DB=dhabi_db
DATABASE_URL=postgresql://dhabi_user:dhabi_pass@postgres:5432/dhabi_db

# Configuración de MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=dhabi_notifications

# Mock de Proveedores (Fallo por defecto: false)
ALDEAMO_FAIL=false
TWILIO_FAIL=false
